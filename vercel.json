{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/rsvp/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.js": {
      "includeFiles": "server/data/**",
      "maxDuration": 60
    }
  }
}
